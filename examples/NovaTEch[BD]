<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nova Tech BD | Dual OTP Dealer System</title>
  
  <!-- Tailwind CSS CDN (via Play CDN - works offline after first load) -->
